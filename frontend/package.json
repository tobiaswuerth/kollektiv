{
  "name": "kollektiv-control-room",
  "private": true,
  "version": "4.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e scripts *.ts *.json index.html",
    "format:check": "prettier --check src e2e scripts *.ts *.json index.html",
    "demo:record": "node scripts/record-demo.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^2.0.0",
    "@xyflow/react": "^12.10.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
